# claude-web : 사내 HTTPS 용 nginx 설정 예시 (Docker Compose)
#
# 쓰는 방법
#   1) 사내 인증서를 host 에 둔다. **git 과 이미지에는 넣지 않는다.**
#          /etc/claude-web/certs/claude-web.crt   (서버 인증서 + 중간 CA 체인)
#          /etc/claude-web/certs/claude-web.key   (개인키, root:root 0600)
#   2) compose.yml 의 nginx 서비스에서 주석을 푼다.
#          ports:   - "443:443"
#          volumes: - ${CERT_DIR:-/etc/claude-web/certs}:/etc/nginx/certs:ro,z
#   3) 이 파일을 docker/nginx.conf 로 복사하고 server_name / 파일명을 고친다.
#   4) .env 에서 SESSION_COOKIE_SECURE=1 로 바꾼다.
#      (HTTPS 에서는 켜는 게 맞다. 반대로 평문 HTTP 에서 1 로 두면 브라우저가
#       쿠키를 저장하지 않아 로그인이 안 된다)
#   5) docker compose restart nginx
#
# 사내 도메인은 Let's Encrypt 로 발급받기 어렵다. (HTTP-01 은 인터넷에서 도달
# 가능해야 하고, DNS-01 은 공인 DNS 가 필요하다) 사내 CA 로 발급받은 인증서를
# 쓰고, 클라이언트 PC 에 사내 루트 CA 가 신뢰 목록에 들어 있어야 한다.

resolver 127.0.0.11 valid=10s ipv6=off;

# --- 80 -> 443 ---------------------------------------------------------------
server {
    listen      80;
    listen      [::]:80;
    server_name claude.example.local;

    location = /healthz {
        access_log   off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- 443 ---------------------------------------------------------------------
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name claude.example.local;

    ssl_certificate     /etc/nginx/certs/claude-web.crt;
    ssl_certificate_key /etc/nginx/certs/claude-web.key;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # HSTS 는 기본으로 켜지 않는다. 같은 호스트명으로 다른 서비스를 HTTP 로
    # 운영하고 있으면 브라우저가 그쪽까지 HTTPS 로 강제해 장애가 된다.
    # 이 호스트가 HTTPS 전용임이 확실할 때만 주석을 푼다.
    #add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 52m;
    client_body_timeout  120s;
    server_tokens        off;

    gzip            on;
    gzip_min_length 1024;
    gzip_proxied    any;
    gzip_types      text/plain text/css application/javascript application/json
                    application/manifest+json image/svg+xml;

    location = /healthz {
        access_log   off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        set $upstream_app http://app:8080;
        proxy_pass $upstream_app$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # 앱이 이 값을 보고 https 를 인식한다. (.env 의 TRUST_PROXY=1 필요)
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header Connection        "";

        proxy_connect_timeout 10s;
        proxy_send_timeout    360s;
        proxy_read_timeout    360s;
        proxy_request_buffering on;
        proxy_buffering         on;
    }
}
