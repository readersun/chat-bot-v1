# /etc/systemd/system/claude-web.service
# 복사: sudo cp claude-web.service /etc/systemd/system/claude-web.service
# User / 경로는 실제 환경에 맞게 수정하세요.
#
# 최초 1회: 기동 후 아래 명령으로 관리자 bootstrap 토큰을 확인하고
#           브라우저에서 /setup 을 엽니다.
#     journalctl -u claude-web -n 50 | grep -i "bootstrap token"
#   또는 셸에서 바로 만들기:
#     sudo -u claude -H /opt/claude-web/venv/bin/python /opt/claude-web/app.py create-admin

[Unit]
Description=Claude Web Portal (Flask + Claude Provider)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# claude CLI 가 로그인된 계정으로 실행해야 인증이 재사용됩니다. (root 아님)
User=claude
Group=claude

WorkingDirectory=/opt/claude-web
EnvironmentFile=/opt/claude-web/.env

# claude CLI 는 ~/.claude 아래 인증정보를 사용하므로 HOME 이 반드시 필요합니다.
Environment=HOME=/home/claude
Environment=PYTHONUNBUFFERED=1

# 서버에 ko_KR.UTF-8 로케일이 생성되어 있지 않아도 한글 로그가 깨지지 않도록
# 파이썬 입출력 인코딩을 로케일과 무관하게 고정한다.
Environment=LANG=ko_KR.UTF-8
Environment=PYTHONIOENCODING=utf-8
Environment=PATH=/opt/claude-web/venv/bin:/usr/local/bin:/usr/bin:/bin

# /var/lib/claude-web 을 systemd 가 만들고 User/Group 소유로 맞춰 줍니다.
# .env 의 DATABASE_PATH / UPLOAD_DIR 를 이 경로로 두면 됩니다.
StateDirectory=claude-web
StateDirectoryMode=0750

ExecStart=/opt/claude-web/venv/bin/python /opt/claude-web/app.py

Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-web

[Install]
WantedBy=multi-user.target
