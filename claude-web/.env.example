# claude-web 설정 예시
# 이 파일을 .env 로 복사한 뒤 환경에 맞게 수정하세요.
#   cp .env.example .env
#
# 이 파일 하나를 두 곳에서 읽습니다.
#   1) 애플리케이션 (python-dotenv)
#   2) Docker Compose  - env_file 로 컨테이너 환경변수가 되고,
#                        compose.yml 의 ${...} 치환에도 쓰입니다.
# 그래서 Docker 배포에서는 아래 "Docker" 절의 값도 여기에 함께 둡니다.
# 주의: Compose 는 값 뒤의 # 을 주석으로 보지 않습니다. (값 줄에 주석을 쓰지 말 것)
#
# ---------------------------------------------------------------------------
# 중요: Claude 연결 설정은 더 이상 여기서 관리하지 않습니다.
#
#   .env          서버 자체 설정 (저장 경로 / 포트 / 키 / 쿠키 / 로그인 정책)
#   관리자 페이지  Claude 연결 설정 (provider, CLI 경로, timeout, 동시 실행 등)
#                 -> /admin/claude 에서 바꾸며 서버 재시작 없이 즉시 반영됩니다.
#
# 아래 CLAUDE_* 값은 **settings 테이블이 비어 있는 최초 1회**에만 초기값으로
# 사용됩니다. 그 뒤로는 관리자 페이지 값이 우선이며 여기를 고쳐도 반영되지
# 않습니다. 기존 .env 로 운영하던 서버를 그대로 올리기 위한 장치입니다.
# ---------------------------------------------------------------------------



# === Docker (compose.yml 이 읽는 값. bare-metal 배포에서는 무시됩니다) ======
# 실행환경 이미지 태그. latest 에 의존하지 말고 명시적인 버전을 씁니다.
# 여기만 바꾸면 runtime 을 통째로 교체할 수 있습니다. (소스는 git 이 관리)
CLAUDE_WEB_IMAGE=claude-web-runtime:1.0.0
NGINX_IMAGE=nginx:1.29-alpine

# nginx 컨테이너가 host 에 노출할 포트. 외부에 열리는 유일한 포트입니다.
# host 의 80 을 다른 웹서버가 쓰고 있으면 여기만 바꾸세요. docker/nginx.conf 는
# 그대로 둡니다. (컨테이너 내부 nginx 는 계속 80 을 듣습니다)
#   예: HTTP_PORT=19780 -> http://<호스트명>:19780/ , 방화벽은 --add-port=19780/tcp
# 32768 이상은 ephemeral 포트 범위와 겹치므로 피하세요.
HTTP_PORT=80

# DB / 업로드 / workspace 를 담을 **host** 디렉터리.
# 컨테이너 안 경로는 항상 /var/lib/claude-web 으로 고정입니다.
HOST_DATA_DIR=/var/lib/claude-web

# 컨테이너 안 claudeweb 사용자의 UID/GID.
# 기본값으로 두어도 됩니다. (init 컨테이너가 데이터 디렉터리를 chown 합니다)
# host 에 이미 데이터가 있고 소유자를 바꾸고 싶지 않을 때만 그 UID/GID 로 맞추고
# docker compose build 를 다시 하세요.
#APP_UID=1000
#APP_GID=1000

# Claude Code apt 저장소 채널. stable = 약 1주 지연된 검증 버전 / latest = 최신
#CLAUDE_CODE_CHANNEL=stable

# === 저장 위치 ==============================================================
# DB 와 업로드 이미지. claude 계정이 쓸 수 있는 경로여야 합니다.
DATABASE_PATH=/var/lib/claude-web/chat.db
UPLOAD_DIR=/var/lib/claude-web/uploads
# 마이그레이션 자동 백업 위치 (기본: DB 와 같은 폴더의 backups/)
#BACKUP_DIR=/var/lib/claude-web/backups


# 메모 첨부파일. 기본값은 DB 와 같은 데이터 루트 아래라 Docker 배포에서 이미
# 마운트된 볼륨에 들어갑니다. (compose 수정 불필요)
#NOTES_DIR=/var/lib/claude-web/notes

# 관리자 Storage 화면이 디스크 용량을 측정할 기준 경로.
# 비우면 DB 가 있는 디렉터리를 씁니다. 컨테이너의 root filesystem 이 아니라
# **실제 데이터가 저장되는** 파일시스템을 봐야 의미가 있습니다.
#STORAGE_MONITOR_PATH=/var/lib/claude-web

# 디렉터리 용량 계산 결과를 이 초 동안 재사용합니다. (0 이면 매번 계산)
# 파일이 수만 개가 되면 순회 비용이 커지므로 짧게 캐시합니다.
# 화면의 [새로고침] 은 캐시를 무시하고 다시 계산합니다.
#STORAGE_CACHE_SECONDS=60


# === 웹 서버 ================================================================
# Docker 배포에서는 이 두 값을 쓰지 않습니다. gunicorn 의 bind 는 compose.yml 이
# GUNICORN_BIND=0.0.0.0:8080 으로 넣어줍니다. (컨테이너 안에서 127.0.0.1 만 들으면
# nginx 컨테이너가 붙지 못합니다. host 에는 publish 하지 않으므로 안전합니다)
#
# nginx 뒤에 두는 bare-metal 배포에서는 루프백만 듣습니다. (gunicorn 도 마찬가지)
# 8080 을 외부에 열지 않으므로 방화벽은 80/443 만 허용하면 됩니다.
# nginx 없이 직접 띄워 시험할 때만 0.0.0.0 으로 바꾸세요.
HOST=127.0.0.1
PORT=8080

# gunicorn (deploy/gunicorn.conf.py 가 읽습니다. 없으면 기본값)
#   GUNICORN_BIND    기본 127.0.0.1:8080
#   GUNICORN_THREADS 기본 8   (워커는 항상 1개. 이유는 gunicorn.conf.py 주석 참고)
#   GUNICORN_TIMEOUT 기본 300 (Claude timeout 보다 크고 nginx 보다 작아야 함)
#GUNICORN_THREADS=8
#GUNICORN_TIMEOUT=300

# 세션 쿠키 서명 키. **반드시 채우세요.**
# 비우면 프로세스마다 랜덤값이라 서버를 재시작할 때마다 전원 로그아웃됩니다.
#   생성: python3 -c "import secrets;print(secrets.token_hex(32))"
# 한 번 정하면 바꾸지 마세요. 바꾸면 전원 로그아웃되고, 관리자 페이지에 저장해 둔
# Claude API Key 도 이 값에서 파생한 키로 암호화돼 있어 복호화되지 않습니다.
SECRET_KEY=


# === 쿠키 / 프록시 ==========================================================
# HTTPS 로 서비스하면 1 을 권장합니다.
# 평문 HTTP 에서 1 로 두면 브라우저가 쿠키를 저장하지 않아 로그인이 안 됩니다.
SESSION_COOKIE_SECURE=0

# 로그인 유지 기간(일)
SESSION_LIFETIME_DAYS=14

# nginx 등 리버스 프록시 뒤에 둘 때만 1. (로그인 제한이 X-Forwarded-For 를 신뢰)
# 프록시가 없는데 켜면 클라이언트가 IP 를 위조할 수 있습니다.
# DEPLOYMENT.md 대로 nginx 를 앞에 두는 구성이면 1 입니다.
TRUST_PROXY=1


# === 로그인 정책 ============================================================
MIN_PASSWORD_LENGTH=8
# 같은 계정에 대한 연속 실패 허용 횟수
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=10
# IP 기준 한도는 위 값의 몇 배로 둘지. 사내 NAT/프록시 때문에 여러 사람이
# 같은 IP 로 보이므로 계정 기준보다 느슨해야 합니다. (5 x 4 = 20회)
LOGIN_IP_FACTOR=4


# === 업로드 / 입력 제한 =====================================================
# 이 두 값을 바꾸면 nginx 의 client_max_body_size 도 같이 바꿔야 합니다.
#   한 요청 최대 크기 = MAX_UPLOAD_MB x MAX_IMAGES_PER_MESSAGE + 1MB
#   기본값이면 10 x 5 + 1 = 51MiB -> nginx 는 52m
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_MESSAGE=5
MAX_INPUT_CHARS=8000

# 메모 첨부파일 제한. 채팅 이미지와 별도입니다.
# 기본값(10 x 5)은 채팅과 같아서 요청 본문 최대 크기가 기존과 동일합니다.
# 즉 nginx 의 client_max_body_size(52m)를 바꿀 필요가 없습니다.
# 이 둘 중 하나를 올리면 nginx 설정도 함께 올려야 합니다.
MAX_NOTE_ATTACHMENT_MB=10
MAX_NOTE_ATTACHMENTS=5
# 메모 제목 / 내용 길이 제한
#MAX_NOTE_TITLE_CHARS=200
#MAX_NOTE_CONTENT_CHARS=50000
# 메모 댓글 한 건의 길이 제한
#MAX_NOTE_COMMENT_CHARS=2000

# provider 가 세션 resume 을 못 쓸 때 프롬프트에 넣을 최근 대화 범위
MAX_HISTORY_MESSAGES=16
MAX_HISTORY_CHARS=12000


# === Claude 초기값 (최초 1회만. 이후에는 /admin/claude 에서 변경) ===========
# cli | api
CLAUDE_PROVIDER=cli
# Docker 배포        -> /usr/bin/claude  (이미지가 apt 로 설치한 경로)
#   확인: docker compose exec app which claude
# bare-metal 배포    -> `sudo -u claudeweb -H which claude` 결과
#   apt 로 설치       -> /usr/bin/claude
#   네이티브 설치     -> /var/lib/claude-web/home/.local/bin/claude
# 이름만 적어도 PATH 에서 찾지만, 절대경로가 더 확실합니다.
CLAUDE_BIN=/usr/bin/claude
# claude -p 를 실행할 디렉터리 (비우면 서버 프로세스의 작업 디렉터리)
CLAUDE_WORKDIR=/var/lib/claude-web/workspace
# 이 값 < gunicorn timeout(300) < nginx proxy_read_timeout(360) 를 지킬 것
CLAUDE_TIMEOUT=180
MAX_CONCURRENT_CLAUDE=3
# 0 으로 두면 --resume 대신 DB 기록을 프롬프트에 넣는 방식으로 동작
CLAUDE_USE_RESUME=1
# claude 에 추가로 넘길 인자. 공백으로 구분. 예: --model sonnet
#CLAUDE_EXTRA_ARGS=

# API provider 를 쓸 때만. 관리자 페이지에서 넣는 것을 권장합니다.
# (여기 적으면 평문 파일에 남습니다)
#CLAUDE_API_KEY=
#CLAUDE_API_MODEL=claude-sonnet-5
#CLAUDE_API_BASE_URL=https://api.anthropic.com

# ---------------------------------------------------------------------------
# 패치 저장소
# ---------------------------------------------------------------------------
# 와칭 루트는 반드시 이 디렉터리 아래에 있어야 한다. 관리자가 등록할 때 검사한다.
#
# 다운로드는 nginx 가 보내고, nginx 는 `location /_patch/ { internal; alias <여기>/; }`
# 한 줄로 그 아래만 열어 둔다. 울타리가 없으면 루트마다 nginx 설정을 고쳐야 하고,
# alias 를 / 로 열면 앱의 버그 하나가 파일시스템 전체를 노출한다.
#
# 마운트가 /mnt/das, /mnt/das2 처럼 여러 개여도 기본값 /mnt 하나로 덮인다.
# 이 값을 바꾸면 docker/nginx.conf 의 alias 와 compose 의 마운트도 같이 바꿀 것.
PATCH_BASE_DIR=/mnt

# 컨테이너에 따로 붙일 스토리지 마운트 지점. (docker 로 띄울 때만 쓴다)
#
# PATCH_BASE_DIR 가 /mnt 를 통째로 붙이는데 이것을 또 두는 이유: host 의 /mnt 가
# shared 묶음이 아닌 서버에서는 컨테이너 안의 /mnt 가 host 와 따로 놀아서,
# host 에서 마운트해도 컨테이너 안에서는 **빈 디렉터리로 보인다.** 실제 마운트
# 지점을 직접 적으면 컨테이너가 뜰 때 그 자리를 그대로 가져온다.
#
#   - PATCH_BASE_DIR 아래여야 한다 (밖이면 루트 등록이 거절된다)
#   - PATCH_BASE_DIR 과 같으면 안 된다 (duplicate mount point 로 뜨지 않는다)
#   - 더 늘리려면 compose.yml 의 그 묶음을 복사해 경로만 바꾼다
PATCH_STORAGE_DIR=/mnt/Storage

# 다운로드를 nginx 에 넘길지. **운영은 반드시 1 이다.**
# 이 앱은 gunicorn 워커 1개 / 스레드 8개로 돈다. 0 으로 두면 Flask 가 파일을
# 들고 부르고, 3GB tar 다운로드 여덟 개가 스레드를 전부 잡아 채팅과 메모와
# 로그인까지 멈춘다. 개발 PC 에는 nginx 가 없으므로 0 으로 둔다.
# (compose 로 띄우면 compose.yml 이 1 로 덮어쓴다)
PATCH_XACCEL=0

# 주기 스캔. 루트별 주기는 관리자 화면에서 바꾼다(기본 10분).
PATCH_SCAN_ENABLED=1
# 주기 스캔 스레드가 "돌 때가 됐나" 를 확인하는 간격(초).
PATCH_SCAN_TICK_SECONDS=60
