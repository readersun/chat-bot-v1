# claude-web 설정 예시
# 이 파일을 .env 로 복사한 뒤 환경에 맞게 수정하세요.
#   cp .env.example .env

# --- Claude CLI ---------------------------------------------------------
# Claude Code CLI 경로 ( which claude 결과 )
CLAUDE_BIN=/usr/local/bin/claude

# claude -p 를 실행할 작업 디렉터리 (비워두면 app.py 가 실행된 디렉터리)
CLAUDE_WORKDIR=/opt/claude-workspace

# claude 프로세스 타임아웃 (초)
CLAUDE_TIMEOUT=180

# 0 으로 두면 --resume 을 쓰지 않고 항상 DB 기록을 프롬프트에 넣는다 (fallback 전용)
CLAUDE_USE_RESUME=1

# (선택) claude 에 추가로 넘길 인자. 공백으로 구분
# CLAUDE_EXTRA_ARGS=--model sonnet

# --- 저장소 -------------------------------------------------------------
DATABASE_PATH=/opt/claude-web/data/chat.db
UPLOAD_DIR=/opt/claude-web/data/uploads

# --- 업로드 제한 --------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_MESSAGE=5

# --- 실행 제한 ----------------------------------------------------------
# 전체 동시 claude 프로세스 수 (세션 단위 lock 은 별도로 항상 동작)
MAX_CONCURRENT_CLAUDE=3

# 사용자 입력 1건 최대 글자 수
MAX_INPUT_CHARS=8000

# resume 을 못 쓸 때 프롬프트에 넣을 최근 대화 범위
MAX_HISTORY_MESSAGES=16
MAX_HISTORY_CHARS=12000

# --- 웹 서버 ------------------------------------------------------------
HOST=0.0.0.0
PORT=8080

# 세션 쿠키 서명 키 (비워두면 프로세스 시작마다 랜덤)
# 생성: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
