# claude-web 설정 예시
# 이 파일을 .env 로 복사한 뒤 환경에 맞게 수정하세요.
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# 중요: Claude 연결 설정은 더 이상 여기서 관리하지 않습니다.
#
#   .env          서버 자체 설정 (저장 경로 / 포트 / 키 / 쿠키 / 로그인 정책)
#   관리자 페이지  Claude 연결 설정 (provider, CLI 경로, timeout, 동시 실행 등)
#                 -> /admin/claude 에서 바꾸며 서버 재시작 없이 즉시 반영됩니다.
#
# 아래 CLAUDE_* 값은 **settings 테이블이 비어 있는 최초 1회**에만 초기값으로
# 사용됩니다. 그 뒤로는 관리자 페이지 값이 우선이며 여기를 고쳐도 반영되지
# 않습니다. 기존 .env 로 운영하던 서버를 그대로 올리기 위한 장치입니다.
# ---------------------------------------------------------------------------


# === 저장 위치 ==============================================================
# DB 와 업로드 이미지. claude 계정이 쓸 수 있는 경로여야 합니다.
DATABASE_PATH=/var/lib/claude-web/chat.db
UPLOAD_DIR=/var/lib/claude-web/uploads
# 마이그레이션 자동 백업 위치 (기본: DB 와 같은 폴더의 backups/)
#BACKUP_DIR=/var/lib/claude-web/backups


# === 웹 서버 ================================================================
# nginx 뒤에 두는 운영 배포에서는 루프백만 듣습니다. (gunicorn 도 마찬가지)
# 8080 을 외부에 열지 않으므로 방화벽은 80/443 만 허용하면 됩니다.
# nginx 없이 직접 띄워 시험할 때만 0.0.0.0 으로 바꾸세요.
HOST=127.0.0.1
PORT=8080

# gunicorn (deploy/gunicorn.conf.py 가 읽습니다. 없으면 기본값)
#   GUNICORN_BIND    기본 127.0.0.1:8080
#   GUNICORN_THREADS 기본 8   (워커는 항상 1개. 이유는 gunicorn.conf.py 주석 참고)
#   GUNICORN_TIMEOUT 기본 300 (Claude timeout 보다 크고 nginx 보다 작아야 함)
#GUNICORN_THREADS=8
#GUNICORN_TIMEOUT=300

# 세션 쿠키 서명 키. **반드시 채우세요.**
# 비우면 프로세스마다 랜덤값이라 서버를 재시작할 때마다 전원 로그아웃됩니다.
#   생성: python3 -c "import secrets;print(secrets.token_hex(32))"
# 한 번 정하면 바꾸지 마세요. 바꾸면 전원 로그아웃되고, 관리자 페이지에 저장해 둔
# Claude API Key 도 이 값에서 파생한 키로 암호화돼 있어 복호화되지 않습니다.
SECRET_KEY=


# === 쿠키 / 프록시 ==========================================================
# HTTPS 로 서비스하면 1 을 권장합니다.
# 평문 HTTP 에서 1 로 두면 브라우저가 쿠키를 저장하지 않아 로그인이 안 됩니다.
SESSION_COOKIE_SECURE=0

# 로그인 유지 기간(일)
SESSION_LIFETIME_DAYS=14

# nginx 등 리버스 프록시 뒤에 둘 때만 1. (로그인 제한이 X-Forwarded-For 를 신뢰)
# 프록시가 없는데 켜면 클라이언트가 IP 를 위조할 수 있습니다.
# DEPLOYMENT.md 대로 nginx 를 앞에 두는 구성이면 1 입니다.
TRUST_PROXY=1


# === 로그인 정책 ============================================================
MIN_PASSWORD_LENGTH=8
# 같은 계정에 대한 연속 실패 허용 횟수
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=10
# IP 기준 한도는 위 값의 몇 배로 둘지. 사내 NAT/프록시 때문에 여러 사람이
# 같은 IP 로 보이므로 계정 기준보다 느슨해야 합니다. (5 x 4 = 20회)
LOGIN_IP_FACTOR=4


# === 업로드 / 입력 제한 =====================================================
# 이 두 값을 바꾸면 nginx 의 client_max_body_size 도 같이 바꿔야 합니다.
#   한 요청 최대 크기 = MAX_UPLOAD_MB x MAX_IMAGES_PER_MESSAGE + 1MB
#   기본값이면 10 x 5 + 1 = 51MiB -> nginx 는 52m
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_MESSAGE=5
MAX_INPUT_CHARS=8000

# provider 가 세션 resume 을 못 쓸 때 프롬프트에 넣을 최근 대화 범위
MAX_HISTORY_MESSAGES=16
MAX_HISTORY_CHARS=12000


# === Claude 초기값 (최초 1회만. 이후에는 /admin/claude 에서 변경) ===========
# cli | api
CLAUDE_PROVIDER=cli
# `sudo -u claudeweb -H which claude` 결과를 넣으세요.
#   apt 로 설치  -> /usr/bin/claude
#   네이티브 설치 -> /var/lib/claude-web/home/.local/bin/claude
# 이름만 적어도 systemd unit 의 PATH 에서 찾습니다. 절대경로가 더 확실합니다.
CLAUDE_BIN=claude
# claude -p 를 실행할 디렉터리 (비우면 서버 프로세스의 작업 디렉터리)
CLAUDE_WORKDIR=/var/lib/claude-web/workspace
# 이 값 < gunicorn timeout(300) < nginx proxy_read_timeout(360) 를 지킬 것
CLAUDE_TIMEOUT=180
MAX_CONCURRENT_CLAUDE=3
# 0 으로 두면 --resume 대신 DB 기록을 프롬프트에 넣는 방식으로 동작
CLAUDE_USE_RESUME=1
# claude 에 추가로 넘길 인자. 공백으로 구분. 예: --model sonnet
#CLAUDE_EXTRA_ARGS=

# API provider 를 쓸 때만. 관리자 페이지에서 넣는 것을 권장합니다.
# (여기 적으면 평문 파일에 남습니다)
#CLAUDE_API_KEY=
#CLAUDE_API_MODEL=claude-sonnet-5
#CLAUDE_API_BASE_URL=https://api.anthropic.com
